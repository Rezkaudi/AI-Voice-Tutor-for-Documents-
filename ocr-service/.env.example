# Engine used when a request doesn't specify one.
OCR_DEFAULT_ENGINE=rapidocr

# Optional language-specific RapidOCR recognition models (ONNX).
# Leave blank to use the bundled Chinese+English model.
# Download from the RapidOCR model zoo and point to the .onnx file:
OCR_RAPIDOCR_JAPANESE_REC_PATH=
OCR_RAPIDOCR_ARABIC_REC_PATH=

# ─── Throughput tuning ───────────────────────────────────────────────────────
# Threads one page may use. Keep small so several pages run in parallel.
OCR_INTRA_THREADS=3
# Pages processed at once (defaults to cores/INTRA_THREADS, e.g. 12/3 = 4).
# OCR_MAX_CONCURRENCY=4
# Text crops batched per recognition pass (higher = faster on dense pages).
OCR_REC_BATCH_NUM=16
# Detection input size cap (lower = faster, may miss tiny text). 736 is default.
OCR_DET_LIMIT_SIDE_LEN=736
# Warm models at startup so the first request isn't slow.
OCR_WARMUP=true

OCR_HOST=0.0.0.0
OCR_PORT=8000
