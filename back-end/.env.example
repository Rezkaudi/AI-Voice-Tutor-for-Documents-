# ─── HTTP ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# Comma-separated origins allowed to call the API (the Vite dev server).
CORS_ORIGINS=http://localhost:5173

# ─── PostgreSQL ────────────────────────────────────────────────────────────
DATABASE_URL=postgres://tutor:tutor@localhost:5432/ai_voice_tutor
# Auto-create schema from entities (development only). Use migrations in prod.
DB_SYNCHRONIZE=true
DB_LOGGING=false

# ─── AWS S3 / object storage ──────────────────────────────────────────────
S3_BUCKET=ai-voice-tutor
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── OpenAI ────────────────────────────────────────────────────────────────
# Powers the agentic tutor, embeddings, text-to-speech, and transcription.
# Optional: when blank, the tutor streams a local demo answer and voice I/O
# is disabled (the front-end falls back to the browser's speech APIs).
OPENAI_API_KEY=
# Tutor model.
OPENAI_TUTOR_MODEL=gpt-5.4-mini
# Speech-to-text and text-to-speech.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_SPEECH_MODEL=gpt-4o-mini-tts
OPENAI_SPEECH_VOICE=alloy

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

ACCESS_TOKEN_TTL=1d
REFRESH_TOKEN_TTL=7d

FRONTEND_URL=http://localhost:5173

# Pages per OCR request. Leave at 1 — throughput comes from concurrency, and
# multi-page requests run long enough to race the client timeout.
DEFAULT_PAGE_EXTRACTION_BATCH_SIZE=1
# Keep under the ocr-service Cloud Run request timeout but well above the
# ~100-125s one page takes on CPU, so the service — not the client — decides
# a page failed. Aborting early leaves it grinding on pages nobody awaits.
OCR_SERVICE_TIMEOUT_MS=840000
# OCR requests in flight per document — this is what sets throughput.
# Keep (concurrency x max parallel documents) under ocr-service max-instances.
PAGE_EXTRACTION_CONCURRENCY=20
PAGE_EXTRACTION_FLUSH_PAGES=16
PAGE_EXTRACTION_FLUSH_MS=5000
PAGE_EXTRACTION_ACTIVE_REPORT_MS=5000
# Retries for saturation responses (429/503) so they never burn page attempts.
OCR_SERVICE_MAX_ATTEMPTS=6

DOCUMENT_URL_TTL_SECONDS=86400

BREVO_API_KEY=
BREVO_LIST_ID=

EXTRACTION_WORKER_TOKEN=change-me-openssl-rand-hex-32
EXTRACTION_WORKER_URL=http://localhost:5000
EXTRACTION_JOB_BUDGET_MS=480000
EXTRACTION_LEASE_TTL_SECONDS=180
GCP_PROJECT_ID=
GCP_TASKS_LOCATION=
GCP_TASKS_QUEUE=
